{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "youbike-track-b-collector",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "youbike-track-b-live",
      "database_id": "c7954c1a-4f80-4415-adf0-db94de6e9644",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "YOUBIKE_API_URL": "https://tcgbusfs.blob.core.windows.net/dotapp/youbike/v2/youbike_immediate.json",
    "EXPORT_PAGE_SIZE": "10000"
  },
  "observability": {
    "enabled": true
  }
}
